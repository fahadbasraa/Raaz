# Database (Neon / Supabase Postgres connection string)
DATABASE_URL="postgresql://user:password@host:5432/raaz?schema=public"

# Public site URL (used for metadata, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth.js
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Stripe
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Resend (transactional email)
# EMAIL_FROM can use Resend's shared sandbox (onboarding@resend.dev) with
# no setup, but it only delivers to the email the Resend account signed up
# with. Verify your own domain at resend.com/domains to email real
# customers from an address like orders@yourdomain.com.
RESEND_API_KEY=""
EMAIL_FROM="RAAZ <orders@yourdomain.com>"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
